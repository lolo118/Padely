rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isImage() {
      return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /profile-photos/{userId}/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId && isImage();
    }
    // El logo del club lo sube el dueño o el staff activo con 'configurarClub' (P3-10)
    function staffConfigura(clubId) {
      let ref = /databases/(default)/documents/clubs/$(clubId)/staff/$(request.auth.uid);
      return firestore.exists(ref) && firestore.get(ref).data.activo == true && 'configurarClub' in firestore.get(ref).data.permisos;
    }
    match /club-logos/{clubId}/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && isImage()
        && (firestore.get(/databases/(default)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid
            || staffConfigura(clubId));
    }
    match /org-logos/{orgId}/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && isImage()
        && firestore.get(/databases/(default)/documents/organizers/$(orgId)).data.ownerUid == request.auth.uid;
    }
  }
}
