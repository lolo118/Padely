# Padely — variables de entorno del cliente (Vite expone solo las que empiezan con VITE_).
# Copiá este archivo a .env para desarrollo local; en Netlify se cargan en Site settings → Environment variables.

# Firebase (obligatorias): Project settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Analytics (opcional): measurementId "G-XXXXXXXXXX". Vacío = sin analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# Sentry (opcional): DSN del proyecto. Vacío = sin Sentry, solo el ErrorBoundary propio.
VITE_SENTRY_DSN=

# WhatsApp de contacto para el botón del footer de la landing, con código de país (ej: 5493851234567). Vacío = sin botón.
VITE_WHATSAPP_CONTACTO=
