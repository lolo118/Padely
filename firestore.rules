rules_version = '2';
// Padely rules v2 — ownership model (deployed from the repo with `npx firebase deploy --only firestore:rules`)
// Lectura pública (sin sesión): torneos, parejas, grupos, clubes, canchas y reviews.
// Reservas, turnos fijos, inscripciones y reclamos requieren sesión. Perfiles (users), organizadores,
// notificaciones y los datos de contacto (contactosReservas, contactosInscripciones, contactos, privado)
// los lee solo su dueño: ningún documento legible por terceros lleva email ni teléfono.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function clubOwner(clubId) {
      return signedIn()
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid;
    }
    // Staff del club (clubs/{c}/staff/{uid}): activo y con el permiso en su lista efectiva
    function staffCon(clubId, permiso) {
      let ref = /databases/$(database)/documents/clubs/$(clubId)/staff/$(request.auth.uid);
      return exists(ref) && get(ref).data.activo == true && permiso in get(ref).data.permisos;
    }
    // El dueño puede todo; el staff, lo que su lista de permisos diga
    function esStaff(clubId, permiso) {
      return signedIn() && (clubOwner(clubId) || staffCon(clubId, permiso));
    }
    // Staff del bar: cualquiera de los permisos del bar (lee productos, categorías, proveedores y movimientos)
    function esStaffBar(clubId) {
      return esStaff(clubId, 'vender') || esStaff(clubId, 'editarProductos') || esStaff(clubId, 'cargarStock')
        || esStaff(clubId, 'importar') || esStaff(clubId, 'pedidos');
    }
    // Staff de la caja: cualquiera de los permisos de caja o vender (lee cajas y movimientos de caja)
    function esStaffCaja(clubId) {
      return esStaff(clubId, 'abrirCaja') || esStaff(clubId, 'cerrarCaja') || esStaff(clubId, 'cerrarCajaAjena')
        || esStaff(clubId, 'verCajasCerradas') || esStaff(clubId, 'vender');
    }
    // Tope de descuento de una venta: el dueño no tiene tope; el staff, descuentoMax (%) de su documento, sobre el
    // subtotal. descuentoTotal = descuentos de línea + descuento general (el cliente lo guarda como campo propio).
    function descuentoPermitido(clubId) {
      return clubOwner(clubId)
        || request.resource.data.descuentoTotal == 0
        || request.resource.data.descuentoTotal * 100
           <= request.resource.data.subtotal
              * get(/databases/$(database)/documents/clubs/$(clubId)/staff/$(request.auth.uid)).data.descuentoMax;
    }
    function cajaAbierta(clubId, cajaId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)/cajas/$(cajaId)).data.estado == 'abierta';
    }
    // Dueño o staff (con el permiso) del club vinculado como sede de un torneo
    function clubStaffOfTournament(tid, permiso) {
      let t = get(/databases/$(database)/documents/tournaments/$(tid)).data;
      return signedIn() && t.get('club', null) != null && esStaff(t.club.id, permiso);
    }
    // La invitación es para el email con el que se inició sesión
    function invitadoPorEmail(inv) {
      return signedIn()
        && request.auth.token.get('email', '') != ''
        && request.auth.token.email.lower() == inv.email;
    }
    // Un documento de staff que se crea aceptando una invitación: la invitación existe, es para este email, está
    // pendiente y no vencida, y el rol y los permisos son los de la invitación
    function invitacionValidaPara(clubId, data) {
      let inv = get(/databases/$(database)/documents/clubs/$(clubId)/invitaciones/$(data.invitacionId)).data;
      return invitadoPorEmail(inv)
        && inv.estado == 'pendiente'
        && inv.vence > request.time
        && data.rol == inv.rol
        && data.permisos == inv.permisos
        && data.descuentoMax == inv.descuentoMax;
    }
    function rolDeStaffValido(rol) {
      return rol in ['encargado', 'cajero', 'barra'];
    }
    function clubReservaDirecta(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data.get('reservaDirecta', true) == true;
    }
    function tournamentOrganizer(tid) {
      return signedIn()
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.organizerId == request.auth.uid;
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // Super-admin de la plataforma: superadmins/{uid}, creado a mano en la consola (ningún cliente lo escribe)
    function superAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }
    // Campos de la suspensión de un club o una entidad organizadora: los escribe solo el super-admin
    function tocaSuspension() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['suspendido', 'suspendidoMotivo', 'suspendidoEn', 'suspendidoPor']);
    }
    function soloSuspension() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['suspendido', 'suspendidoMotivo', 'suspendidoEn', 'suspendidoPor']);
    }
    // Un club o entidad nace sin suspender
    function naceActivo() {
      return request.resource.data.get('suspendido', false) == false;
    }
    // El club acepta reservas de jugadores (sin el campo = activo)
    function clubActivo(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data.get('suspendido', false) == false;
    }
    // El vínculo con un club que escribe un organizador: sin club, pendiente, o aceptado solo si el club es suyo.
    // Así "aceptado" solo lo pone el dueño del club (acá o respondiendo el pedido) y la Function puede confiar en él.
    function clubVinculoValido() {
      let c = request.resource.data.get('club', null);
      return c == null || c.get('estado', null) == 'pendiente' || clubOwner(c.id);
    }
    // El vínculo no cambia (mismo club, mismo estado): el organizador está editando otra cosa
    function clubSinCambios() {
      let antes = resource.data.get('club', null);
      let despues = request.resource.data.get('club', null);
      return antes != null && despues != null && despues.id == antes.id && despues.estado == antes.estado;
    }
    // Turnos bloqueados por un torneo (tipo "torneo"): los escriben solo las Cloud Functions
    function reservaDeTorneo() {
      return resource.data.get('tipo', null) == 'torneo';
    }
    function nuevaReservaDeTorneo() {
      return request.resource.data.get('tipo', null) == 'torneo';
    }
    function pairMember(tid, pairId) {
      let p = get(/databases/$(database)/documents/tournaments/$(tid)/pairs/$(pairId)).data;
      return p.get('jugador1Uid', null) == request.auth.uid || p.get('jugador2Uid', null) == request.auth.uid;
    }
    // Los documentos que leen terceros no llevan datos de contacto: esos van a las subcolecciones privadas
    function sinContacto(campos) {
      return !request.resource.data.keys().hasAny(campos);
    }

    // "Mis reservas": a player reads his reservations across clubs (collection group query)
    match /{path=**}/reservas/{reservaId} {
      allow read: if signedIn();
    }

    // "Mi cuenta": el jugador lee sus cuentas del turno en cualquier club (la consulta lleva where("jugadorUid", "==", auth.uid))
    match /{path=**}/cuentas/{cuentaId} {
      allow read: if signedIn() && resource.data.jugadorUid == request.auth.uid;
    }
    // Mis pedidos a la barra, en cualquier club (misma consulta por jugadorUid; también para sesiones anónimas)
    match /{path=**}/pedidos/{pedidoId} {
      allow read: if signedIn() && resource.data.jugadorUid == request.auth.uid;
    }

    // Al entrar, cada persona busca los clubes donde es staff (la consulta lleva where("uid", "==", auth.uid))
    match /{path=**}/staff/{uid} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || superAdmin();
    }

    // Quién es super-admin: lo lee solo la propia cuenta; nadie lo escribe desde un cliente
    match /superadmins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Perfil (email, teléfono, nacimiento...): lo lee solo el propio usuario. Parejas y reservas llevan el
    // nombre a mostrar; un ranking público se publicaría como proyección desde una Cloud Function.
    match /users/{userId} {
      allow read: if isSelf(userId) || superAdmin();
      allow create: if isSelf(userId);
      allow delete: if isSelf(userId);
      // Own profile: anything except role and ranking fields. The super-admin only fixes the role (one of three).
      allow update: if (isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'puntos', 'nivel', 'partidosGanados', 'partidosPerdidos', 'partidosJugados',
                     'torneosJugados', 'torneosGanados', 'torneosGanadosEnCategoria', 'ascensos']))
        || (superAdmin()
            && changedOnly(['role'])
            && request.resource.data.role.size() == 1
            && request.resource.data.role[0] in ['jugador', 'club', 'organizador']);

      match /notifications/{notifId} {
        allow read: if isSelf(userId);
        allow create: if signedIn();
        allow update: if isSelf(userId) && changedOnly(['leida']);
        allow delete: if isSelf(userId);
      }
    }

    // Entidad organizadora (email, teléfono, equipo de trabajo): la lee solo su dueño. El contacto público
    // de un torneo lo elige el organizador en el torneo (whatsappOrganizador, instagramOrganizador, administradores).
    match /organizers/{orgId} {
      allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid) || superAdmin();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && naceActivo();
      // El dueño edita su entidad sin tocar la suspensión; el super-admin solo suspende o reactiva
      allow update: if (signedIn() && resource.data.ownerUid == request.auth.uid && !tocaSuspension())
        || (superAdmin() && soloSuspension());
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && naceActivo();
      // Configura el dueño o el staff con 'configurarClub' (que nunca cambia el dueño ni la fecha de alta); ninguno
      // de los dos toca la suspensión, que es del super-admin (y él solo toca esos campos). Borrar: solo el dueño.
      allow update: if (clubOwner(clubId) && !tocaSuspension())
        || (signedIn() && staffCon(clubId, 'configurarClub')
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'createdAt'])
            && !tocaSuspension())
        || (superAdmin() && soloSuspension());
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Datos privados del club (CBU, alias, CUIT, razón social): quien configura; los teléfonos de los turnos
      // fijos, quien gestiona reservas. El documento clubs/{clubId} es de lectura pública y no debe contenerlos.
      match /privado/{docId} {
        allow read, write: if (docId == 'datos' && esStaff(clubId, 'configurarClub'))
          || (docId == 'turnosFijos' && esStaff(clubId, 'gestionarReservas'));
      }

      match /canchas/{canchaId} {
        allow read: if true;
        allow create, update, delete: if esStaff(clubId, 'tarifas');
      }

      // Los jugadores leen los turnos fijos para la grilla; el teléfono del cliente va en privado/turnosFijos
      match /turnosFijos/{turnoId} {
        allow read: if signedIn();
        allow create, update: if esStaff(clubId, 'gestionarReservas') && sinContacto(['telefono']);
        allow delete: if esStaff(clubId, 'gestionarReservas');
      }

      // ----- Bar: productos, categorías, proveedores y movimientos de stock -----
      // El stock de un producto lo escribe solo la Cloud Function (onMovimientoStockCreated) a partir de los
      // movimientos: se crea en 0 y ningún cliente lo cambia.
      // Los jugadores y el QR leen la proyección pública `catalogo` (sin costo ni stock), nunca esto.
      match /productos/{productoId} {
        allow read: if esStaffBar(clubId) || superAdmin();
        allow create: if esStaff(clubId, 'editarProductos') && request.resource.data.stock == 0;
        allow update: if esStaff(clubId, 'editarProductos')
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stock']);
        allow delete: if esStaff(clubId, 'editarProductos');
      }

      match /categoriasProductos/{categoriaId} {
        allow read: if esStaffBar(clubId) || superAdmin();
        allow create, update, delete: if esStaff(clubId, 'editarProductos');
      }

      match /proveedores/{proveedorId} {
        allow read: if esStaffBar(clubId) || superAdmin();
        allow create, delete: if esStaff(clubId, 'editarProductos');
        // Quien importa guarda el mapeo de columnas del proveedor (solo ese campo)
        allow update: if esStaff(clubId, 'editarProductos')
          || (esStaff(clubId, 'importar') && changedOnly(['mapeoImportacion']));
      }

      // Registro de movimientos: solo altas (una corrección es un movimiento nuevo); 'aplicado' lo pone la Function
      match /movimientosStock/{movimientoId} {
        allow read: if esStaffBar(clubId) || superAdmin();
        allow create: if request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.aplicado == false
          && request.resource.data.cantidad is number
          && request.resource.data.cantidad != 0
          && request.resource.data.tipo in ['compra', 'ajuste', 'merma', 'importacion']
          && ((request.resource.data.tipo in ['compra', 'ajuste', 'merma'] && esStaff(clubId, 'cargarStock'))
              || (request.resource.data.tipo == 'importacion'
                  && (esStaff(clubId, 'importar') || esStaff(clubId, 'cargarStock'))));
        allow update, delete: if false;
      }

      // ----- Bar: caja (un turno de un dispositivo) y sus movimientos -----
      // La caja es un registro: `totales` lo escribe SOLO la Cloud Function (onMovimientoCajaCreated) a partir de
      // movimientosCaja. Nace en cero y ningún cliente lo toca. Se cierra una sola vez, con el arqueo.
      match /cajas/{cajaId} {
        allow read: if esStaffCaja(clubId) || superAdmin();
        allow create: if esStaff(clubId, 'abrirCaja')
          && request.resource.data.estado == 'abierta'
          && request.resource.data.abiertaPor == request.auth.uid
          && request.resource.data.fondoInicial is number
          && request.resource.data.fondoInicial >= 0
          && request.resource.data.totales.efectivo == 0
          && request.resource.data.totales.transferencia == 0
          && request.resource.data.totales.tarjeta == 0
          && request.resource.data.totales.qr == 0
          && request.resource.data.totales.movimientos == 0
          && request.resource.data.get('cerradaEn', null) == null
          && request.resource.data.get('arqueo', null) == null
          && request.resource.data.get('diferencia', null) == null;
        // Cierre (una vez, de abierta a cerrada, por quien la abrió con 'cerrarCaja' o por quien cierra cajas ajenas),
        // o renombrar el dispositivo mientras está abierta. Nunca totales, fondoInicial ni quién la abrió.
        allow update: if resource.data.estado == 'abierta'
          && ((changedOnly(['estado', 'cerradaPor', 'cerradaPorNombre', 'cerradaEn', 'arqueo', 'esperadoEfectivo',
                            'diferencia', 'observaciones', 'actualizadoEn'])
               && request.resource.data.estado == 'cerrada'
               && request.resource.data.cerradaPor == request.auth.uid
               && ((esStaff(clubId, 'cerrarCaja') && resource.data.abiertaPor == request.auth.uid)
                   || esStaff(clubId, 'cerrarCajaAjena')))
              || (changedOnly(['dispositivo', 'actualizadoEn'])
                  && request.resource.data.dispositivo is string
                  && request.resource.data.dispositivo.size() > 0
                  && esStaff(clubId, 'abrirCaja')));
        allow delete: if false;
      }

      // Movimientos de caja: solo altas, sobre una caja abierta; 'aplicado' lo pone la Function. Los tipos
      // venta / anulacion / cobroCuenta / seña los escriben solo las Functions (P3-3, P3-4).
      match /movimientosCaja/{movimientoId} {
        allow read: if esStaffCaja(clubId) || superAdmin();
        allow create: if (esStaff(clubId, 'abrirCaja') || esStaff(clubId, 'cerrarCaja') || esStaff(clubId, 'vender'))
          && request.resource.data.tipo in ['retiro', 'ingreso', 'gasto']
          && request.resource.data.medio in ['efectivo', 'transferencia', 'tarjeta', 'qr']
          && request.resource.data.monto is number
          && request.resource.data.monto > 0
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.aplicado == false
          && (request.resource.data.tipo == 'ingreso'
              || (request.resource.data.nota is string && request.resource.data.nota.size() > 0))
          && request.resource.data.cajaId is string
          && get(/databases/$(database)/documents/clubs/$(clubId)/cajas/$(request.resource.data.cajaId)).data.estado == 'abierta';
        allow update, delete: if false;
      }

      // ----- Bar: reportes diarios, catálogo público, alertas de stock y tickets públicos (los escriben SOLO las Functions) -----
      // reportesDiarios/{YYYY-MM-DD}: lo que ve Reportes (quien tiene verReportes).
      match /reportesDiarios/{fecha} {
        allow read: if esStaff(clubId, 'verReportes') || superAdmin();
        allow write: if false;
      }
      // catalogo/{productoId} y catalogo/_categorias: nombre, precio, categoría, favorito, activo, agotado (bool) —
      // sin costo ni cantidades. Lo leen jugadores y sesiones anónimas (QR de la cancha) para pedir.
      match /catalogo/{docId} {
        allow read: if signedIn();
        allow write: if false;
      }
      // alertasStock/{productoId}: productos en o bajo el mínimo (los ve el bar)
      match /alertasStock/{productoId} {
        allow read: if esStaffBar(clubId) || superAdmin();
        allow write: if false;
      }
      // ticketsPublicos/{numero}: el ticket digital (/t/v/{clubId}/{numero}). Público: nombre del club, ítems,
      // totales, medios y montos. Nunca creadoPor, cajaId ni referencias de pago.
      match /ticketsPublicos/{numero} {
        allow read: if true;
        allow write: if false;
      }

      // ----- Bar: ventas (inmutables; el id ES el número de ticket) y contadores de numeración por dispositivo -----
      // El stock y la caja los mueven las Functions (movimientos "venta"/"anulacion", que los clientes no pueden
      // crear). El cliente nunca escribe `aplicado`. Una venta solo cambia para anularse, con motivo, mientras la
      // caja sigue abierta.
      match /ventas/{ventaId} {
        allow read: if esStaffCaja(clubId) || esStaff(clubId, 'vender') || superAdmin();
        allow create: if esStaff(clubId, 'vender')
          && request.resource.data.numero == ventaId
          && request.resource.data.estado == 'ok'
          && request.resource.data.aplicado == false
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.subtotal is number
          && request.resource.data.descuentoTotal is number
          && request.resource.data.descuentoTotal >= 0
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.pagado is number
          && request.resource.data.pagado >= request.resource.data.total
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.anulacion == null
          // Sin cuenta: venta de mostrador. Con cuenta: la cuenta del turno existe y sigue abierta (sus líneas de
          // cancha y seña no tienen producto y la seña va en negativo: por eso solo se admiten con cuentaId).
          && (request.resource.data.cuentaId == null
              || (request.resource.data.cuentaId is string
                  && get(/databases/$(database)/documents/clubs/$(clubId)/cuentas/$(request.resource.data.cuentaId)).data.estado == 'abierta'))
          && request.resource.data.fiscal == null
          && request.resource.data.cajaId is string
          && cajaAbierta(clubId, request.resource.data.cajaId)
          && descuentoPermitido(clubId);
        allow update: if esStaff(clubId, 'anularVenta')
          && changedOnly(['estado', 'anulacion', 'actualizadoEn'])
          && resource.data.estado == 'ok'
          && request.resource.data.estado == 'anulada'
          && request.resource.data.anulacion.por == request.auth.uid
          && request.resource.data.anulacion.motivo is string
          && request.resource.data.anulacion.motivo.size() > 0
          && cajaAbierta(clubId, resource.data.cajaId);
        allow delete: if false;
      }

      // Numeración: _asignacion = { ultimo } reparte códigos "D1", "D2"…; {codigo} = { desde, hasta, usado } lleva los
      // bloques de 100 números de cada dispositivo. Las transacciones las corre el cliente que vende.
      match /contadoresDispositivos/{codigo} {
        allow read, write: if esStaff(clubId, 'vender');
      }

      // ----- Bar: cuenta del turno (id = grupoId de la reserva; una reserva, a lo sumo una cuenta) -----
      // La crea el POS al cargar el primer consumo; la cierra el staff cobrándola (sus ventas llevan cuentaId).
      // Hasta el cierre nada se mueve: el stock lo mueve la Function onCuentaUpdated una sola vez; la caja, las
      // ventas. El jugador que reservó la lee (y nada más). Campos que escribe SOLO la Function: cuentaAplicada,
      // avisoVencidaEnviado, cierreAutomatico; en reservas: cuentaCerrada, cuentaTotal, cuentaCerradaEn.
      match /cuentas/{cuentaId} {
        allow read: if esStaffCaja(clubId) || esStaff(clubId, 'cobrarTurnos') || esStaff(clubId, 'vender')
          || (signedIn() && resource.data.jugadorUid == request.auth.uid)
          || superAdmin();
        allow create: if (esStaff(clubId, 'cobrarTurnos') || esStaff(clubId, 'vender') || esStaff(clubId, 'pedidos'))
          && request.resource.data.estado == 'abierta'
          && request.resource.data.abiertaPor == request.auth.uid
          && request.resource.data.reservaGrupoId == cuentaId
          && get(/databases/$(database)/documents/clubs/$(clubId)/reservas/$(cuentaId)).data.status == 'confirmada'
          && request.resource.data.ventas.size() == 0
          && request.resource.data.cerradaEn == null;
        // Mientras está abierta: editar consumos / cancha / división (y anotar las ventas de las partes cobradas),
        // o cerrarla (cerrada: quien cobra; anulada: quien puede anular ventas). Quien atiende la barra ('pedidos')
        // solo suma consumos (al aceptar un pedido). Una cuenta anulada se puede reabrir (vuelve vacía, con lo
        // anterior en historial) por quien cobra o atiende la barra. Campos de la Function: cuentaAplicada,
        // avisoVencidaEnviado, cierreAutomatico, pedidosPendientes.
        allow update: if (resource.data.estado == 'abierta'
            && (((esStaff(clubId, 'cobrarTurnos') || esStaff(clubId, 'vender'))
                 && changedOnly(['items', 'totales', 'division', 'cancha', 'ventas', 'actualizadoEn', 'nombreJugador'])
                 && request.resource.data.estado == 'abierta')
                || (esStaff(clubId, 'pedidos')
                    && changedOnly(['items', 'totales', 'division', 'actualizadoEn'])
                    && request.resource.data.estado == 'abierta')
                || ((esStaff(clubId, 'cobrarTurnos') || esStaff(clubId, 'vender'))
                    && changedOnly(['estado', 'cerradaPor', 'cerradaEn', 'ventas', 'division', 'totales', 'anulacion', 'actualizadoEn'])
                    && request.resource.data.estado in ['cerrada', 'anulada']
                    && request.resource.data.cerradaPor == request.auth.uid
                    && (request.resource.data.estado == 'cerrada' || esStaff(clubId, 'anularVenta')))))
          || (resource.data.estado == 'anulada'
              && (esStaff(clubId, 'cobrarTurnos') || esStaff(clubId, 'vender') || esStaff(clubId, 'pedidos'))
              && request.resource.data.estado == 'abierta'
              && request.resource.data.abiertaPor == request.auth.uid
              && request.resource.data.ventas.size() == 0
              && request.resource.data.cerradaEn == null
              && changedOnly(['estado', 'items', 'totales', 'division', 'ventas', 'cerradaPor', 'cerradaEn', 'anulacion',
                              'historial', 'abiertaPor', 'abiertaPorNombre', 'abiertaEn', 'actualizadoEn']));
        allow delete: if false;
      }

      // ----- Bar: pedidos a la barra (desde el celular del jugador o el QR de la cancha) -----
      // Los crea un usuario con sesión (real o anónima) a su propio nombre (jugadorUid). "celular": el jugador que
      // reservó; "qr": cualquiera en la cancha, con el token impreso en el QR (los anónimos solo por acá). El jugador
      // cancela mientras está en espera; la barra ('pedidos') lo acepta / rechaza / marca listo y entregado.
      // Campos de la Function: notificado, validado, pedidosPendientes (en la cuenta); el qrToken lo borra ella.
      function reservaDelPedido(clubId) {
        return get(/databases/$(database)/documents/clubs/$(clubId)/reservas/$(request.resource.data.reservaGrupoId)).data;
      }
      function esAnonimo() {
        return request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
      }
      match /pedidos/{pedidoId} {
        allow read: if esStaff(clubId, 'pedidos') || esStaffCaja(clubId) || esStaff(clubId, 'vender')
          || (signedIn() && resource.data.jugadorUid == request.auth.uid)
          || superAdmin();
        allow create: if signedIn()
          && request.resource.data.jugadorUid == request.auth.uid
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 20
          && request.resource.data.subtotal is number
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.lineaIds.size() == 0
          && request.resource.data.atendidoPor == null
          && request.resource.data.reservaGrupoId == request.resource.data.cuentaId
          && reservaDelPedido(clubId).status == 'confirmada'
          && request.resource.data.canchaId == reservaDelPedido(clubId).canchaId
          && ((request.resource.data.origen == 'celular'
               && request.resource.data.anonimo == false
               && !esAnonimo()
               && reservaDelPedido(clubId).jugadorUid == request.auth.uid)
              || (request.resource.data.origen == 'qr'
                  && request.resource.data.anonimo == esAnonimo()
                  && request.resource.data.qrToken is string
                  && request.resource.data.qrToken.size() > 0
                  && request.resource.data.qrToken
                     == get(/databases/$(database)/documents/clubs/$(clubId)/canchas/$(request.resource.data.canchaId)).data.get('qrToken', null)));
        allow update: if (signedIn()
            && resource.data.jugadorUid == request.auth.uid
            && resource.data.estado == 'pendiente'
            && changedOnly(['estado', 'tiempos', 'actualizadoEn'])
            && request.resource.data.estado == 'cancelado')
          || (esStaff(clubId, 'pedidos')
            && changedOnly(['estado', 'rechazo', 'tiempos', 'atendidoPor', 'atendidoPorNombre', 'lineaIds', 'actualizadoEn'])
            && request.resource.data.atendidoPor == request.auth.uid
            && ((resource.data.estado == 'pendiente' && request.resource.data.estado in ['aceptado', 'rechazado'])
                || (resource.data.estado == 'aceptado' && request.resource.data.estado == 'listo')
                || (resource.data.estado == 'listo' && request.resource.data.estado == 'entregado'))
            && (request.resource.data.estado != 'rechazado'
                || (request.resource.data.rechazo.motivo is string && request.resource.data.rechazo.motivo.size() > 0)));
        allow delete: if false;
      }

      // Equipo del club. El dueño no tiene documento acá (clubs/{clubId}.ownerUid puede todo).
      match /staff/{uid} {
        allow read: if isSelf(uid) || esStaff(clubId, 'gestionarStaff') || superAdmin();
        // Acepta una invitación: el propio usuario crea su doc con los datos de la invitación pendiente, no vencida,
        // dirigida a su email (en el mismo batch marca la invitación como aceptada)
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.activo == true
          && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'nombre', 'email', 'rol', 'permisos', 'descuentoMax',
                                                   'activo', 'invitacionId', 'invitadoPor', 'creadoEn', 'actualizadoEn'])
          && rolDeStaffValido(request.resource.data.rol)
          && invitacionValidaPara(clubId, request.resource.data);
        // El dueño edita a cualquiera; quien gestiona el equipo, a los demás (nunca su propio rol, permisos o acceso)
        allow update: if (clubOwner(clubId) || (signedIn() && staffCon(clubId, 'gestionarStaff') && uid != request.auth.uid))
          && changedOnly(['rol', 'permisos', 'descuentoMax', 'activo', 'nombre', 'actualizadoEn'])
          && rolDeStaffValido(request.resource.data.rol);
        allow delete: if clubOwner(clubId)
          || (signedIn() && staffCon(clubId, 'gestionarStaff') && uid != request.auth.uid)
          || isSelf(uid);
      }

      match /invitaciones/{invId} {
        allow read: if esStaff(clubId, 'gestionarStaff') || invitadoPorEmail(resource.data);
        allow create: if esStaff(clubId, 'gestionarStaff')
          && request.resource.data.estado == 'pendiente'
          && rolDeStaffValido(request.resource.data.rol);
        // El club la cancela; el invitado la acepta (mismo batch que crea su doc de staff)
        allow update: if (esStaff(clubId, 'gestionarStaff')
              && changedOnly(['estado'])
              && request.resource.data.estado == 'cancelada')
          || (invitadoPorEmail(resource.data)
              && resource.data.estado == 'pendiente'
              && resource.data.vence > request.time
              && changedOnly(['estado', 'uid', 'aceptadaEn'])
              && request.resource.data.estado == 'aceptada'
              && request.resource.data.uid == request.auth.uid);
        allow delete: if esStaff(clubId, 'gestionarStaff');
      }

      match /reservas/{reservaId} {
        allow read: if signedIn();
        // Campos de la Function (onCuentaUpdated, Admin SDK): cuentaCerrada, cuentaTotal, cuentaCerradaEn. Ningún
        // cliente los escribe (los formularios del club y del jugador no los tocan).
        // The club books manually or blocks a slot; a player books for himself with the status the club's config dictates.
        // Email y teléfono de quien reserva van en contactosReservas/{reservaId}, nunca acá.
        allow create: if sinContacto(['email', 'telefono'])
          && !nuevaReservaDeTorneo()
          && (esStaff(clubId, 'gestionarReservas')
              || (signedIn()
                  && request.resource.data.jugadorUid == request.auth.uid
                  && clubActivo(clubId)
                  && ((clubReservaDirecta(clubId) && request.resource.data.status == 'confirmada')
                      || (!clubReservaDirecta(clubId) && request.resource.data.status == 'pendiente'))));
        // The club manages; a player may cancel his own, or re-book a slot whose previous reservation was cancelled
        allow update: if !reservaDeTorneo() && !nuevaReservaDeTorneo()
          && (esStaff(clubId, 'gestionarReservas')
              || (signedIn() && resource.data.get('jugadorUid', null) == request.auth.uid
                  && changedOnly(['status']) && request.resource.data.status == 'cancelada')
              || (signedIn() && resource.data.status == 'cancelada'
                  && sinContacto(['email', 'telefono'])
                  && request.resource.data.jugadorUid == request.auth.uid
                  && clubActivo(clubId)
                  && ((clubReservaDirecta(clubId) && request.resource.data.status == 'confirmada')
                      || (!clubReservaDirecta(clubId) && request.resource.data.status == 'pendiente'))));
        allow delete: if !reservaDeTorneo() && esStaff(clubId, 'gestionarReservas');
      }

      // Contacto (email/teléfono) de quien reservó, con el id de la reserva: lo lee solo el club. Lo escribe
      // el club, o el jugador en la misma transacción que crea su reserva (getAfter ve la reserva tal como queda).
      match /contactosReservas/{reservaId} {
        allow read, delete: if esStaff(clubId, 'gestionarReservas');
        allow create, update: if esStaff(clubId, 'gestionarReservas')
          || (signedIn()
              && request.resource.data.jugadorUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/clubs/$(clubId)/reservas/$(reservaId)).data.jugadorUid
                 == request.auth.uid);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /tournaments/{tid} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid && clubVinculoValido();
      // El organizador edita todo salvo poner "aceptado" en un club ajeno; el club sede (dueño o staff con
      // 'gestionarTorneos') solo responde el pedido (club.estado) sin cambiar el club
      allow update: if (signedIn() && resource.data.organizerId == request.auth.uid
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['club'])
                || clubSinCambios()
                || clubVinculoValido()))
        || (clubStaffOfTournament(tid, 'gestionarTorneos')
            && changedOnly(['club'])
            && request.resource.data.club.id == resource.data.club.id
            && request.resource.data.club.diff(resource.data.club).affectedKeys().hasOnly(['estado'])
            && request.resource.data.club.estado in ['aceptado', 'rechazado']);
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;

      match /pairs/{pairId} {
        allow read: if true;
        allow create, delete: if tournamentOrganizer(tid);
        // The organizer edits; a player links his own account into an empty slot (vinculación)
        allow update: if tournamentOrganizer(tid)
          || (signedIn() && changedOnly(['jugador1Uid'])
              && resource.data.get('jugador1Uid', null) == null
              && request.resource.data.jugador1Uid == request.auth.uid)
          || (signedIn() && changedOnly(['jugador2Uid'])
              && resource.data.get('jugador2Uid', null) == null
              && request.resource.data.jugador2Uid == request.auth.uid);
      }

      // Contactos de las parejas (WhatsApp/email): solo el organizador. Nunca van en pairs, groups ni en el
      // bracket del torneo, que son de lectura pública.
      match /contactos/{pairId} {
        allow read, write: if tournamentOrganizer(tid);
      }

      // Marcadores de puntos otorgados: los escriben solo las Cloud Functions
      match /puntosOtorgados/{markerId} {
        allow read: if signedIn();
      }

      match /groups/{groupId} {
        allow read: if true;
        allow create, update, delete: if tournamentOrganizer(tid);
      }

      // Un cuadro por categoría: el bracket de cada una ({ label, bracketJson, actualizadoEn }). Público, como los grupos.
      match /cuadros/{cuadroId} {
        allow read: if true;
        allow create, update, delete: if tournamentOrganizer(tid);
      }

      match /inscripciones/{inscId} {
        allow read: if signedIn();
        // Email y WhatsApp de los jugadores van en contactosInscripciones/{inscId}, nunca acá
        allow create: if signedIn() && request.resource.data.jugador1Uid == request.auth.uid
          && sinContacto(['email1', 'email2', 'whatsapp1', 'whatsapp2']);
        // The organizer confirms/rejects; the invited partner accepts (must be logged in)
        allow update: if tournamentOrganizer(tid)
          || (signedIn()
              && resource.data.status == 'esperando_companero'
              && changedOnly(['status', 'jugador2Uid', 'jugador2Confirmado'])
              && request.resource.data.jugador2Uid == request.auth.uid
              && request.resource.data.status == 'pendiente_aprobacion');
        allow delete: if tournamentOrganizer(tid);
      }

      // Contactos de una inscripción (email/WhatsApp de los dos jugadores), con el id de la inscripción: los lee
      // solo el organizador. Los escribe el jugador 1 en el mismo batch que su inscripción, o el organizador.
      match /contactosInscripciones/{inscId} {
        allow read, update, delete: if tournamentOrganizer(tid);
        allow create: if tournamentOrganizer(tid)
          || (signedIn()
              && request.resource.data.jugador1Uid == request.auth.uid
              && getAfter(/databases/$(database)/documents/tournaments/$(tid)/inscripciones/$(inscId)).data.jugador1Uid
                 == request.auth.uid);
      }

      match /reclamos/{reclamoId} {
        allow read: if signedIn();
        // Only a player linked to the denouncing pair can open a reclamo
        allow create: if signedIn() && pairMember(tid, request.resource.data.parejaDenunciante.id);
        // The organizer resolves; any linked player may adhere or leave a descargo
        allow update: if tournamentOrganizer(tid)
          || (signedIn() && changedOnly(['adheridos']))
          || (signedIn() && changedOnly(['descargo']));
        allow delete: if tournamentOrganizer(tid);
      }
    }
  }
}
