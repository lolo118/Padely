rules_version = '2';
// Padely rules v2 — ownership model (deployed from the repo with `npx firebase deploy --only firestore:rules`)
// Lectura pública (sin sesión): torneos, parejas, grupos, clubes, canchas y reviews.
// Reservas, turnos fijos, inscripciones y reclamos requieren sesión. Perfiles (users), organizadores,
// notificaciones y los datos de contacto (contactosReservas, contactosInscripciones, contactos, privado)
// los lee solo su dueño: ningún documento legible por terceros lleva email ni teléfono.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function clubOwner(clubId) {
      return signedIn()
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid;
    }
    function clubReservaDirecta(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data.get('reservaDirecta', true) == true;
    }
    function tournamentOrganizer(tid) {
      return signedIn()
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.organizerId == request.auth.uid;
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function pairMember(tid, pairId) {
      let p = get(/databases/$(database)/documents/tournaments/$(tid)/pairs/$(pairId)).data;
      return p.get('jugador1Uid', null) == request.auth.uid || p.get('jugador2Uid', null) == request.auth.uid;
    }
    // Los documentos que leen terceros no llevan datos de contacto: esos van a las subcolecciones privadas
    function sinContacto(campos) {
      return !request.resource.data.keys().hasAny(campos);
    }

    // "Mis reservas": a player reads his reservations across clubs (collection group query)
    match /{path=**}/reservas/{reservaId} {
      allow read: if signedIn();
    }

    // Perfil (email, teléfono, nacimiento...): lo lee solo el propio usuario. Parejas y reservas llevan el
    // nombre a mostrar; un ranking público se publicaría como proyección desde una Cloud Function.
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId);
      allow delete: if isSelf(userId);
      // Own profile: anything except role and ranking fields
      allow update: if isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'puntos', 'nivel', 'partidosGanados', 'partidosPerdidos', 'partidosJugados',
                     'torneosJugados', 'torneosGanados', 'torneosGanadosEnCategoria', 'ascensos']);

      match /notifications/{notifId} {
        allow read: if isSelf(userId);
        allow create: if signedIn();
        allow update: if isSelf(userId) && changedOnly(['leida']);
        allow delete: if isSelf(userId);
      }
    }

    // Entidad organizadora (email, teléfono, equipo de trabajo): la lee solo su dueño. El contacto público
    // de un torneo lo elige el organizador en el torneo (whatsappOrganizador, instagramOrganizador, administradores).
    match /organizers/{orgId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Datos privados del club (CBU, alias, CUIT, razón social, usuarios del club): solo el dueño.
      // El documento clubs/{clubId} es de lectura pública y no debe contenerlos.
      match /privado/{docId} {
        allow read, write: if clubOwner(clubId);
      }

      match /canchas/{canchaId} {
        allow read: if true;
        allow create, update, delete: if clubOwner(clubId);
      }

      // Los jugadores leen los turnos fijos para la grilla; el teléfono del cliente va en privado/turnosFijos
      match /turnosFijos/{turnoId} {
        allow read: if signedIn();
        allow create, update: if clubOwner(clubId) && sinContacto(['telefono']);
        allow delete: if clubOwner(clubId);
      }

      match /reservas/{reservaId} {
        allow read: if signedIn();
        // The club books manually or blocks a slot; a player books for himself with the status the club's config dictates.
        // Email y teléfono de quien reserva van en contactosReservas/{reservaId}, nunca acá.
        allow create: if sinContacto(['email', 'telefono'])
          && (clubOwner(clubId)
              || (signedIn()
                  && request.resource.data.jugadorUid == request.auth.uid
                  && ((clubReservaDirecta(clubId) && request.resource.data.status == 'confirmada')
                      || (!clubReservaDirecta(clubId) && request.resource.data.status == 'pendiente'))));
        // The club manages; a player may cancel his own, or re-book a slot whose previous reservation was cancelled
        allow update: if clubOwner(clubId)
          || (signedIn() && resource.data.get('jugadorUid', null) == request.auth.uid
              && changedOnly(['status']) && request.resource.data.status == 'cancelada')
          || (signedIn() && resource.data.status == 'cancelada'
              && sinContacto(['email', 'telefono'])
              && request.resource.data.jugadorUid == request.auth.uid
              && ((clubReservaDirecta(clubId) && request.resource.data.status == 'confirmada')
                  || (!clubReservaDirecta(clubId) && request.resource.data.status == 'pendiente')));
        allow delete: if clubOwner(clubId);
      }

      // Contacto (email/teléfono) de quien reservó, con el id de la reserva: lo lee solo el club. Lo escribe
      // el club, o el jugador en la misma transacción que crea su reserva (getAfter ve la reserva tal como queda).
      match /contactosReservas/{reservaId} {
        allow read, delete: if clubOwner(clubId);
        allow create, update: if clubOwner(clubId)
          || (signedIn()
              && request.resource.data.jugadorUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/clubs/$(clubId)/reservas/$(reservaId)).data.jugadorUid
                 == request.auth.uid);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /tournaments/{tid} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.organizerId == request.auth.uid;

      match /pairs/{pairId} {
        allow read: if true;
        allow create, delete: if tournamentOrganizer(tid);
        // The organizer edits; a player links his own account into an empty slot (vinculación)
        allow update: if tournamentOrganizer(tid)
          || (signedIn() && changedOnly(['jugador1Uid'])
              && resource.data.get('jugador1Uid', null) == null
              && request.resource.data.jugador1Uid == request.auth.uid)
          || (signedIn() && changedOnly(['jugador2Uid'])
              && resource.data.get('jugador2Uid', null) == null
              && request.resource.data.jugador2Uid == request.auth.uid);
      }

      // Contactos de las parejas (WhatsApp/email): solo el organizador. Nunca van en pairs, groups ni en el
      // bracket del torneo, que son de lectura pública.
      match /contactos/{pairId} {
        allow read, write: if tournamentOrganizer(tid);
      }

      // Marcadores de puntos otorgados: los escriben solo las Cloud Functions
      match /puntosOtorgados/{markerId} {
        allow read: if signedIn();
      }

      match /groups/{groupId} {
        allow read: if true;
        allow create, update, delete: if tournamentOrganizer(tid);
      }

      // Un cuadro por categoría: el bracket de cada una ({ label, bracketJson, actualizadoEn }). Público, como los grupos.
      match /cuadros/{cuadroId} {
        allow read: if true;
        allow create, update, delete: if tournamentOrganizer(tid);
      }

      match /inscripciones/{inscId} {
        allow read: if signedIn();
        // Email y WhatsApp de los jugadores van en contactosInscripciones/{inscId}, nunca acá
        allow create: if signedIn() && request.resource.data.jugador1Uid == request.auth.uid
          && sinContacto(['email1', 'email2', 'whatsapp1', 'whatsapp2']);
        // The organizer confirms/rejects; the invited partner accepts (must be logged in)
        allow update: if tournamentOrganizer(tid)
          || (signedIn()
              && resource.data.status == 'esperando_companero'
              && changedOnly(['status', 'jugador2Uid', 'jugador2Confirmado'])
              && request.resource.data.jugador2Uid == request.auth.uid
              && request.resource.data.status == 'pendiente_aprobacion');
        allow delete: if tournamentOrganizer(tid);
      }

      // Contactos de una inscripción (email/WhatsApp de los dos jugadores), con el id de la inscripción: los lee
      // solo el organizador. Los escribe el jugador 1 en el mismo batch que su inscripción, o el organizador.
      match /contactosInscripciones/{inscId} {
        allow read, update, delete: if tournamentOrganizer(tid);
        allow create: if tournamentOrganizer(tid)
          || (signedIn()
              && request.resource.data.jugador1Uid == request.auth.uid
              && getAfter(/databases/$(database)/documents/tournaments/$(tid)/inscripciones/$(inscId)).data.jugador1Uid
                 == request.auth.uid);
      }

      match /reclamos/{reclamoId} {
        allow read: if signedIn();
        // Only a player linked to the denouncing pair can open a reclamo
        allow create: if signedIn() && pairMember(tid, request.resource.data.parejaDenunciante.id);
        // The organizer resolves; any linked player may adhere or leave a descargo
        allow update: if tournamentOrganizer(tid)
          || (signedIn() && changedOnly(['adheridos']))
          || (signedIn() && changedOnly(['descargo']));
        allow delete: if tournamentOrganizer(tid);
      }
    }
  }
}
