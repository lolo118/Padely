rules_version = '2';
// Padely rules v2 — ownership model (deployed from the repo with `npx firebase deploy --only firestore:rules`)
// Lectura pública (sin sesión): torneos, parejas, grupos, clubes, canchas y reviews.
// Reservas, turnos fijos, inscripciones y reclamos requieren sesión. Perfiles (users), organizadores,
// notificaciones y los datos de contacto (contactosReservas, contactosInscripciones, contactos, privado)
// los lee solo su dueño: ningún documento legible por terceros lleva email ni teléfono.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function clubOwner(clubId) {
      return signedIn()
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid;
    }
    // Staff del club (clubs/{c}/staff/{uid}): activo y con el permiso en su lista efectiva
    function staffCon(clubId, permiso) {
      let ref = /databases/$(database)/documents/clubs/$(clubId)/staff/$(request.auth.uid);
      return exists(ref) && get(ref).data.activo == true && permiso in get(ref).data.permisos;
    }
    // El dueño puede todo; el staff, lo que su lista de permisos diga
    function esStaff(clubId, permiso) {
      return signedIn() && (clubOwner(clubId) || staffCon(clubId, permiso));
    }
    // Dueño o staff (con el permiso) del club vinculado como sede de un torneo
    function clubStaffOfTournament(tid, permiso) {
      let t = get(/databases/$(database)/documents/tournaments/$(tid)).data;
      return signedIn() && t.get('club', null) != null && esStaff(t.club.id, permiso);
    }
    // La invitación es para el email con el que se inició sesión
    function invitadoPorEmail(inv) {
      return signedIn()
        && request.auth.token.get('email', '') != ''
        && request.auth.token.email.lower() == inv.email;
    }
    // Un documento de staff que se crea aceptando una invitación: la invitación existe, es para este email, está
    // pendiente y no vencida, y el rol y los permisos son los de la invitación
    function invitacionValidaPara(clubId, data) {
      let inv = get(/databases/$(database)/documents/clubs/$(clubId)/invitaciones/$(data.invitacionId)).data;
      return invitadoPorEmail(inv)
        && inv.estado == 'pendiente'
        && inv.vence > request.time
        && data.rol == inv.rol
        && data.permisos == inv.permisos
        && data.descuentoMax == inv.descuentoMax;
    }
    function rolDeStaffValido(rol) {
      return rol in ['encargado', 'cajero', 'barra'];
    }
    function clubReservaDirecta(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data.get('reservaDirecta', true) == true;
    }
    function tournamentOrganizer(tid) {
      return signedIn()
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.organizerId == request.auth.uid;
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // Super-admin de la plataforma: superadmins/{uid}, creado a mano en la consola (ningún cliente lo escribe)
    function superAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }
    // Campos de la suspensión de un club o una entidad organizadora: los escribe solo el super-admin
    function tocaSuspension() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['suspendido', 'suspendidoMotivo', 'suspendidoEn', 'suspendidoPor']);
    }
    function soloSuspension() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['suspendido', 'suspendidoMotivo', 'suspendidoEn', 'suspendidoPor']);
    }
    // Un club o entidad nace sin suspender
    function naceActivo() {
      return request.resource.data.get('suspendido', false) == false;
    }
    // El club acepta reservas de jugadores (sin el campo = activo)
    function clubActivo(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data.get('suspendido', false) == false;
    }
    // El vínculo con un club que escribe un organizador: sin club, pendiente, o aceptado solo si el club es suyo.
    // Así "aceptado" solo lo pone el dueño del club (acá o respondiendo el pedido) y la Function puede confiar en él.
    function clubVinculoValido() {
      let c = request.resource.data.get('club', null);
      return c == null || c.get('estado', null) == 'pendiente' || clubOwner(c.id);
    }
    // El vínculo no cambia (mismo club, mismo estado): el organizador está editando otra cosa
    function clubSinCambios() {
      let antes = resource.data.get('club', null);
      let despues = request.resource.data.get('club', null);
      return antes != null && despues != null && despues.id == antes.id && despues.estado == antes.estado;
    }
    // Turnos bloqueados por un torneo (tipo "torneo"): los escriben solo las Cloud Functions
    function reservaDeTorneo() {
      return resource.data.get('tipo', null) == 'torneo';
    }
    function nuevaReservaDeTorneo() {
      return request.resource.data.get('tipo', null) == 'torneo';
    }
    function pairMember(tid, pairId) {
      let p = get(/databases/$(database)/documents/tournaments/$(tid)/pairs/$(pairId)).data;
      return p.get('jugador1Uid', null) == request.auth.uid || p.get('jugador2Uid', null) == request.auth.uid;
    }
    // Los documentos que leen terceros no llevan datos de contacto: esos van a las subcolecciones privadas
    function sinContacto(campos) {
      return !request.resource.data.keys().hasAny(campos);
    }

    // "Mis reservas": a player reads his reservations across clubs (collection group query)
    match /{path=**}/reservas/{reservaId} {
      allow read: if signedIn();
    }

    // Al entrar, cada persona busca los clubes donde es staff (la consulta lleva where("uid", "==", auth.uid))
    match /{path=**}/staff/{uid} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || superAdmin();
    }

    // Quién es super-admin: lo lee solo la propia cuenta; nadie lo escribe desde un cliente
    match /superadmins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Perfil (email, teléfono, nacimiento...): lo lee solo el propio usuario. Parejas y reservas llevan el
    // nombre a mostrar; un ranking público se publicaría como proyección desde una Cloud Function.
    match /users/{userId} {
      allow read: if isSelf(userId) || superAdmin();
      allow create: if isSelf(userId);
      allow delete: if isSelf(userId);
      // Own profile: anything except role and ranking fields. The super-admin only fixes the role (one of three).
      allow update: if (isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'puntos', 'nivel', 'partidosGanados', 'partidosPerdidos', 'partidosJugados',
                     'torneosJugados', 'torneosGanados', 'torneosGanadosEnCategoria', 'ascensos']))
        || (superAdmin()
            && changedOnly(['role'])
            && request.resource.data.role.size() == 1
            && request.resource.data.role[0] in ['jugador', 'club', 'organizador']);

      match /notifications/{notifId} {
        allow read: if isSelf(userId);
        allow create: if signedIn();
        allow update: if isSelf(userId) && changedOnly(['leida']);
        allow delete: if isSelf(userId);
      }
    }

    // Entidad organizadora (email, teléfono, equipo de trabajo): la lee solo su dueño. El contacto público
    // de un torneo lo elige el organizador en el torneo (whatsappOrganizador, instagramOrganizador, administradores).
    match /organizers/{orgId} {
      allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid) || superAdmin();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && naceActivo();
      // El dueño edita su entidad sin tocar la suspensión; el super-admin solo suspende o reactiva
      allow update: if (signedIn() && resource.data.ownerUid == request.auth.uid && !tocaSuspension())
        || (superAdmin() && soloSuspension());
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && naceActivo();
      // Configura el dueño o el staff con 'configurarClub' (que nunca cambia el dueño ni la fecha de alta); ninguno
      // de los dos toca la suspensión, que es del super-admin (y él solo toca esos campos). Borrar: solo el dueño.
      allow update: if (clubOwner(clubId) && !tocaSuspension())
        || (signedIn() && staffCon(clubId, 'configurarClub')
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'createdAt'])
            && !tocaSuspension())
        || (superAdmin() && soloSuspension());
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Datos privados del club (CBU, alias, CUIT, razón social): quien configura; los teléfonos de los turnos
      // fijos, quien gestiona reservas. El documento clubs/{clubId} es de lectura pública y no debe contenerlos.
      match /privado/{docId} {
        allow read, write: if (docId == 'datos' && esStaff(clubId, 'configurarClub'))
          || (docId == 'turnosFijos' && esStaff(clubId, 'gestionarReservas'));
      }

      match /canchas/{canchaId} {
        allow read: if true;
        allow create, update, delete: if esStaff(clubId, 'tarifas');
      }

      // Los jugadores leen los turnos fijos para la grilla; el teléfono del cliente va en privado/turnosFijos
      match /turnosFijos/{turnoId} {
        allow read: if signedIn();
        allow create, update: if esStaff(clubId, 'gestionarReservas') && sinContacto(['telefono']);
        allow delete: if esStaff(clubId, 'gestionarReservas');
      }

      // Equipo del club. El dueño no tiene documento acá (clubs/{clubId}.ownerUid puede todo).
      match /staff/{uid} {
        allow read: if isSelf(uid) || esStaff(clubId, 'gestionarStaff') || superAdmin();
        // Acepta una invitación: el propio usuario crea su doc con los datos de la invitación pendiente, no vencida,
        // dirigida a su email (en el mismo batch marca la invitación como aceptada)
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.activo == true
          && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'nombre', 'email', 'rol', 'permisos', 'descuentoMax',
                                                   'activo', 'invitacionId', 'invitadoPor', 'creadoEn', 'actualizadoEn'])
          && rolDeStaffValido(request.resource.data.rol)
          && invitacionValidaPara(clubId, request.resource.data);
        // El dueño edita a cualquiera; quien gestiona el equipo, a los demás (nunca su propio rol, permisos o acceso)
        allow update: if (clubOwner(clubId) || (signedIn() && staffCon(clubId, 'gestionarStaff') && uid != request.auth.uid))
          && changedOnly(['rol', 'permisos', 'descuentoMax', 'activo', 'nombre', 'actualizadoEn'])
          && rolDeStaffValido(request.resource.data.rol);
        allow delete: if clubOwner(clubId)
          || (signedIn() && staffCon(clubId, 'gestionarStaff') && uid != request.auth.uid)
          || isSelf(uid);
      }

      match /invitaciones/{invId} {
        allow read: if esStaff(clubId, 'gestionarStaff') || invitadoPorEmail(resource.data);
        allow create: if esStaff(clubId, 'gestionarStaff')
          && request.resource.data.estado == 'pendiente'
          && rolDeStaffValido(request.resource.data.rol);
        // El club la cancela; el invitado la acepta (mismo batch que crea su doc de staff)
        allow update: if (esStaff(clubId, 'gestionarStaff')
              && changedOnly(['estado'])
              && request.resource.data.estado == 'cancelada')
          || (invitadoPorEmail(resource.data)
              && resource.data.estado == 'pendiente'
              && resource.data.vence > request.time
              && changedOnly(['estado', 'uid', 'aceptadaEn'])
              && request.resource.data.estado == 'aceptada'
              && request.resource.data.uid == request.auth.uid);
        allow delete: if esStaff(clubId, 'gestionarStaff');
      }

      match /reservas/{reservaId} {
        allow read: if signedIn();
        // The club books manually or blocks a slot; a player books for himself with the status the club's config dictates.
        // Email y teléfono de quien reserva van en contactosReservas/{reservaId}, nunca acá.
        allow create: if sinContacto(['email', 'telefono'])
          && !nuevaReservaDeTorneo()
          && (esStaff(clubId, 'gestionarReservas')
              || (signedIn()
                  && request.resource.data.jugadorUid == request.auth.uid
                  && clubActivo(clubId)
                  && ((clubReservaDirecta(clubId) && request.resource.data.status == 'confirmada')
                      || (!clubReservaDirecta(clubId) && request.resource.data.status == 'pendiente'))));
        // The club manages; a player may cancel his own, or re-book a slot whose previous reservation was cancelled
        allow update: if !reservaDeTorneo() && !nuevaReservaDeTorneo()
          && (esStaff(clubId, 'gestionarReservas')
              || (signedIn() && resource.data.get('jugadorUid', null) == request.auth.uid
                  && changedOnly(['status']) && request.resource.data.status == 'cancelada')
              || (signedIn() && resource.data.status == 'cancelada'
                  && sinContacto(['email', 'telefono'])
                  && request.resource.data.jugadorUid == request.auth.uid
                  && clubActivo(clubId)
                  && ((clubReservaDirecta(clubId) && request.resource.data.status == 'confirmada')
                      || (!clubReservaDirecta(clubId) && request.resource.data.status == 'pendiente'))));
        allow delete: if !reservaDeTorneo() && esStaff(clubId, 'gestionarReservas');
      }

      // Contacto (email/teléfono) de quien reservó, con el id de la reserva: lo lee solo el club. Lo escribe
      // el club, o el jugador en la misma transacción que crea su reserva (getAfter ve la reserva tal como queda).
      match /contactosReservas/{reservaId} {
        allow read, delete: if esStaff(clubId, 'gestionarReservas');
        allow create, update: if esStaff(clubId, 'gestionarReservas')
          || (signedIn()
              && request.resource.data.jugadorUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/clubs/$(clubId)/reservas/$(reservaId)).data.jugadorUid
                 == request.auth.uid);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /tournaments/{tid} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid && clubVinculoValido();
      // El organizador edita todo salvo poner "aceptado" en un club ajeno; el club sede (dueño o staff con
      // 'gestionarTorneos') solo responde el pedido (club.estado) sin cambiar el club
      allow update: if (signedIn() && resource.data.organizerId == request.auth.uid
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['club'])
                || clubSinCambios()
                || clubVinculoValido()))
        || (clubStaffOfTournament(tid, 'gestionarTorneos')
            && changedOnly(['club'])
            && request.resource.data.club.id == resource.data.club.id
            && request.resource.data.club.diff(resource.data.club).affectedKeys().hasOnly(['estado'])
            && request.resource.data.club.estado in ['aceptado', 'rechazado']);
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;

      match /pairs/{pairId} {
        allow read: if true;
        allow create, delete: if tournamentOrganizer(tid);
        // The organizer edits; a player links his own account into an empty slot (vinculación)
        allow update: if tournamentOrganizer(tid)
          || (signedIn() && changedOnly(['jugador1Uid'])
              && resource.data.get('jugador1Uid', null) == null
              && request.resource.data.jugador1Uid == request.auth.uid)
          || (signedIn() && changedOnly(['jugador2Uid'])
              && resource.data.get('jugador2Uid', null) == null
              && request.resource.data.jugador2Uid == request.auth.uid);
      }

      // Contactos de las parejas (WhatsApp/email): solo el organizador. Nunca van en pairs, groups ni en el
      // bracket del torneo, que son de lectura pública.
      match /contactos/{pairId} {
        allow read, write: if tournamentOrganizer(tid);
      }

      // Marcadores de puntos otorgados: los escriben solo las Cloud Functions
      match /puntosOtorgados/{markerId} {
        allow read: if signedIn();
      }

      match /groups/{groupId} {
        allow read: if true;
        allow create, update, delete: if tournamentOrganizer(tid);
      }

      // Un cuadro por categoría: el bracket de cada una ({ label, bracketJson, actualizadoEn }). Público, como los grupos.
      match /cuadros/{cuadroId} {
        allow read: if true;
        allow create, update, delete: if tournamentOrganizer(tid);
      }

      match /inscripciones/{inscId} {
        allow read: if signedIn();
        // Email y WhatsApp de los jugadores van en contactosInscripciones/{inscId}, nunca acá
        allow create: if signedIn() && request.resource.data.jugador1Uid == request.auth.uid
          && sinContacto(['email1', 'email2', 'whatsapp1', 'whatsapp2']);
        // The organizer confirms/rejects; the invited partner accepts (must be logged in)
        allow update: if tournamentOrganizer(tid)
          || (signedIn()
              && resource.data.status == 'esperando_companero'
              && changedOnly(['status', 'jugador2Uid', 'jugador2Confirmado'])
              && request.resource.data.jugador2Uid == request.auth.uid
              && request.resource.data.status == 'pendiente_aprobacion');
        allow delete: if tournamentOrganizer(tid);
      }

      // Contactos de una inscripción (email/WhatsApp de los dos jugadores), con el id de la inscripción: los lee
      // solo el organizador. Los escribe el jugador 1 en el mismo batch que su inscripción, o el organizador.
      match /contactosInscripciones/{inscId} {
        allow read, update, delete: if tournamentOrganizer(tid);
        allow create: if tournamentOrganizer(tid)
          || (signedIn()
              && request.resource.data.jugador1Uid == request.auth.uid
              && getAfter(/databases/$(database)/documents/tournaments/$(tid)/inscripciones/$(inscId)).data.jugador1Uid
                 == request.auth.uid);
      }

      match /reclamos/{reclamoId} {
        allow read: if signedIn();
        // Only a player linked to the denouncing pair can open a reclamo
        allow create: if signedIn() && pairMember(tid, request.resource.data.parejaDenunciante.id);
        // The organizer resolves; any linked player may adhere or leave a descargo
        allow update: if tournamentOrganizer(tid)
          || (signedIn() && changedOnly(['adheridos']))
          || (signedIn() && changedOnly(['descargo']));
        allow delete: if tournamentOrganizer(tid);
      }
    }
  }
}
