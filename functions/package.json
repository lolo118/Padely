{
  "name": "padely-functions",
  "private": true,
  "description": "Cloud Functions de Padely: puntos y ranking, vencimiento de reservas pendientes, limpieza de cuentas eliminadas",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "sync": "node sync-utils.mjs",
    "test": "node sync-utils.mjs && node --test *.test.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.4.0"
  }
}
